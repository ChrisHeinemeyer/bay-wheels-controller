# make a copy of this file called ".env" and set the variables accordingly
SSID="YOUR SSID"
PASSWORD="YOUR WIFI PASSWORD"
# Only read with the log-server feature: where each fetch cycle POSTs telemetry
# (see homeassistant/bay_wheels_log).
LOG_SERVER="10.0.0.107:8099"
# Only read with the gbfs-mirror feature: the Home Assistant add-on that mirrors
# the GBFS feed (usually the same host:port as LOG_SERVER).
GBFS_MIRROR="10.0.0.107:8099"
